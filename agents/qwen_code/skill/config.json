{
  "agent": "Qwen Code",
  "agent_key": "qwen_code",
  "trigger": "/mem",
  "context_file": ".qwen/memory_context.md",
  "workspace_env": "QWEN_CODE_WORKSPACE",
  "auto_memory": true,
  "auto_learn": true,
  "learn_interval_hours": 2,
  "max_search_results": 5,
  "min_importance_threshold": 0.3,
  "version": "1.0.0"
}