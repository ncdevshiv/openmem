{
  "agent": "Codex CLI",
  "agent_key": "codex_cli",
  "trigger": "/mem",
  "context_file": ".codex/context.md",
  "workspace_env": "CODEX_WORKSPACE",
  "auto_memory": true,
  "auto_learn": true,
  "learn_interval_hours": 2,
  "max_search_results": 5,
  "min_importance_threshold": 0.3,
  "version": "1.0.0"
}