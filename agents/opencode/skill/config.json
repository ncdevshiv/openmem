{
  "agent": "OpenCode",
  "agent_key": "opencode",
  "trigger": "/memory",
  "context_file": ".opencode/context.md",
  "workspace_env": "OPENCODE_WORKSPACE",
  "auto_memory": true,
  "auto_learn": true,
  "learn_interval_hours": 2,
  "max_search_results": 5,
  "min_importance_threshold": 0.3,
  "version": "1.0.0"
}