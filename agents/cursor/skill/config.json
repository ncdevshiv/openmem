{
  "agent": "Cursor",
  "agent_key": "cursor",
  "trigger": "@memory",
  "context_file": ".cursor/rules/memory.md",
  "workspace_env": "CURSOR_WORKSPACE",
  "auto_memory": true,
  "auto_learn": true,
  "learn_interval_hours": 2,
  "max_search_results": 5,
  "min_importance_threshold": 0.3,
  "version": "1.0.0"
}